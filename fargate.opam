# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "TUI for AWS Batch fill jobs: running list, live logs, stall detection, kill"
description:
  "fargate watches the v11f- jobs in an AWS Batch queue. The left pane lists the running jobs with their job definition, uptime, time since last log output and progress; the right pane streams the selected job's CloudWatch log. Every log stream is tailed continuously so switching between jobs is instant. A job that has produced no output for more than a configurable number of seconds is flagged STALLED, and a key terminates the selected job."
maintainer: ["Mark Elvers <mark.elvers@tunbury.org>"]
authors: ["Mark Elvers <mark.elvers@tunbury.org>"]
license: "MIT"
depends: [
  "dune" {>= "3.19"}
  "ocaml" {>= "5.1"}
  "notty"
  "cmdliner"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
